  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Registrar usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufijo único por ejecución para correo, ISBN y nombre de categoría.",
                  "pm.collectionVariables.set(\"sufijo\", String(Date.now()).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"La respuesta es JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "const usuario = pm.response.json();",
                  "pm.test(\"Devuelve id, nombre y correo\", function () {",
                  "    pm.expect(usuario.id).to.be.a(\"number\");",
                  "    pm.expect(usuario.nombre).to.eql(\"Juan Sebastián Ávila\");",
                  "    pm.expect(usuario.correo).to.include(\"@librerialuz.com\");",
                  "});",
                  "pm.test(\"No expone la contraseña ni su hash\", function () {",
                  "    pm.expect(usuario).to.not.have.property(\"contrasena\");",
                  "    pm.expect(usuario).to.not.have.property(\"contrasenaHash\");",
                  "});",
                  "pm.collectionVariables.set(\"usuarioId\", usuario.id);",
                  "pm.collectionVariables.set(\"correo\", usuario.correo);",
                  "pm.test(\"Responde en menos de 2 segundos\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea una cuenta. Se genera un sufijo único para poder repetir la ejecución sin chocar con datos anteriores.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Sebastián Ávila\",\n  \"correo\": \"juan.avila{{sufijo}}@librerialuz.com\",\n  \"contrasena\": \"ClaveSegura123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.2 Registrar usuario duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Mensaje: El correo ya está registrado.\", function () {",
